# ---- 容器里用不上的 Windows 引擎（.exe 在 Linux 跑不了，排除可省 414MB）----
egaroucid/
gnugo/
katago/
pikafish/
rapfi/
stockfish/

# ---- 版本库与 Windows 批处理 ----
.git/
*.cmd

# ---- 运行时数据：绝对不要打进镜像 ----
# 镜像里若自带 data.db，容器启动时会误判"本地已有数据库"而跳过 Neon 恢复
data.db
data.db-wal
data.db-shm
data.db-journal
.secret_key
neon_dsn.txt
uploads/
static/avatars/
data_backups/

# ---- 缓存与日志 ----
__pycache__/
*.pyc
*.log
_write_test.tmp

# ---- 其它平台的配置（Zeabur 走 Dockerfile，不读这些）----
render.yaml
.python-version
requirements.txt
